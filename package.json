{
  "name": "dsh-tray-restart",
  "version": "1.0.0",
  "type": "module",
  "description": "给 DeepSeek Harness 桌面端托盘右键菜单加一条「重启 DeepSeek Harness」：等长补丁 app.asar 里的托盘菜单，应用升级后自动补回。Adds a \"Restart\" item to the DSH desktop tray menu.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "desktop",
    "tray",
    "restart",
    "windows",
    "asar"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/tray-patch.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaayeaaa-P1WS/dsh-tray-restart.git"
  },
  "homepage": "https://github.com/aaayeaaa-P1WS/dsh-tray-restart#readme",
  "bugs": {
    "url": "https://github.com/aaayeaaa-P1WS/dsh-tray-restart/issues"
  }
}
